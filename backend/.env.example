# Copie este arquivo para ".env" (na mesma pasta) e preencha com os valores reais.
# NUNCA cometa o arquivo ".env" no Git — ele já está listado no .gitignore.

# Conexão com o MySQL 8: mysql://usuario:senha@host:3306/nome_do_banco
# Se a senha tiver caracteres especiais (@ / ? # % :), codifique-a na URL
# (python -c "import urllib.parse; print(urllib.parse.quote('SENHA', safe=''))")
# OU deixe a senha fora da URL (mysql://usuario@host:3306/banco) e use DATABASE_PASSWORD.
# No docker-compose.yml local essas duas já são preenchidas a partir do .env da raiz.
DATABASE_URL=mysql://usuario@localhost:3306/mediary
DATABASE_PASSWORD=
# Opcional: caminho do certificado da CA para exigir TLS com o banco (ex.: AWS RDS).
DATABASE_SSL_CA=

# "producao" exige SECRET_KEY e tira localhost da lista de origens do CORS.
AMBIENTE=desenvolvimento

# Chave secreta usada para assinar os tokens JWT.
# Gere uma chave forte e aleatória, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_secreta_forte_e_aleatoria

# URL(s) do frontend autorizadas pelo CORS (separadas por vírgula se houver mais de uma)
FRONTEND_URL=http://localhost:80

# ── Inteligência artificial (opcional) ───────────────────────────────────────
# Sem a chave, os recursos de IA ficam ocultos no app e o resto funciona normalmente.
# Crie a chave em https://platform.claude.com (API keys). NUNCA coloque no frontend.
ANTHROPIC_API_KEY=
# Modelos usados (os padrões já servem): um rápido e barato para entender o que o
# paciente conta, e um mais forte para escrever o resumo da consulta.
IA_MODELO_EXTRACAO=claude-haiku-5-5
IA_MODELO_RESUMO=claude-sonnet-5-5
# Quantas vezes cada usuário pode usar por dia (controla custo e abuso).
IA_LIMITE_DIARIO_INTERPRETAR=40
IA_LIMITE_DIARIO_RESUMO=10

