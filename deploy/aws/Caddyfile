# Site e API no mesmo endereço, com HTTPS automático (Let's Encrypt):
#   https://DOMINIO/        -> frontend (arquivos estáticos do React)
#   https://DOMINIO/api/*   -> backend Flask
#   https://www.DOMINIO/*   -> redireciona para https://DOMINIO
# Sem diretiva "log": nada de log de acesso (as URLs têm datas de sintomas).
{
	admin off
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Microfone liberado só para o próprio site (cadastro por voz).
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv

		# Arquivos com hash no nome: cache longo. Todo o resto (index.html, rotas do
		# React, sw.js, manifesto, ícones) é revalidado a cada visita, para o PWA
		# nunca ficar preso numa versão antiga.
		@assets path /assets/* /workbox-*.js
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@outros not path /assets/* /workbox-*.js
		header @outros Cache-Control "no-cache"

		# SPA: qualquer rota do React cai no index.html.
		try_files {path} /index.html
		file_server
	}
}
